# environment
venv/
__pycache__/
*.pyc

# training data - personal voice recordings, never push
dataset/
# derived from dataset/, so it carries the same verbatim dictation
dataset_cleanup/

# anything transcription/audio related (belt and suspenders - app never writes these)
*.wav
# ...except the CC0 UI feedback chimes, which are not dictation audio
!sounds/*.wav
# runtime-padded copies, rebuilt on demand
sounds/_cache/
*.mp3
*.flac
transcripts/
history/
*.log

# local-only overrides
config.local.json

# tooling caches
.memsearch/
.ruff_cache/

# machine-specific settings (copy config.example.json -> config.json)
config.json
# dated rollback copies left behind by model/config experiments
config.json.pre-*

# Claude Code local overrides (machine-specific)
.claude/settings.local.json
